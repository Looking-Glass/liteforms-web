{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "../dist-electron",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["main.ts", "nativeBridge.ts", "nativeBridgePaths.ts", "nativeBridgeProbe.ts", "nextServer.ts", "preload.ts"],
  "exclude": ["*.test.ts"]
}
