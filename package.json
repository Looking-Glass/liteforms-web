{
  "name": "liteforms-web",
  "description": "Browser-first avatar chat app with an optional Electron desktop build.",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Liteforms contributors",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "npm run build:electron:main && cross-env LITEFORMS_ELECTRON_DEV_SERVER_URL=http://localhost:3000 electron .",
    "build": "next build",
    "build:electron": "npm run build:electron:main && npm run build:electron:next",
    "build:electron:main": "tsc -p electron/tsconfig.json",
    "build:electron:next": "cross-env LITEFORMS_ELECTRON_BUILD=1 next build && node scripts/prepare-electron-next.mjs",
    "dist:electron": "npm run build:electron && electron-builder --config electron-builder.config.cjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke:providers": "vitest run --config vitest.smoke.config.ts lib/smoke/providerSmoke.smoke.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lookingglass/bridge": "^0.0.8-alpha.4",
    "@lookingglass/webxr": "^0.6.0",
    "@pixiv/three-vrm": "^3.5.2",
    "@pixiv/three-vrm-animation": "^3.5.2",
    "idb": "^8.0.0",
    "koffi": "^3.0.2",
    "kokoro-js": "^1.2.1",
    "next": "^15.0.0",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.0",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^29.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
